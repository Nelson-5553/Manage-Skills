{
  "name": "manage-skills",
  "displayName": "Manage Skills",
  "description": "Automate skill installation for AI agents. Detect your project's tech stack and automatically install relevant skills for smarter AI assistance.",
  "version": "0.1.0-beta",
  "engines": {
    "vscode": "^1.115.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "manageSkillsView",
          "title": "Manage Skills",
          "icon": "$(search-sparkle)"
        }
      ]
    },
    "views": {
      "manageSkillsView": [
        {
          "id": "suggestedSkillsView",
          "name": "Suggested Skills",
          "icon": "$(light-bulb)"
        },
        {
          "id": "skillsView",
          "name": "Skills",
          "icon": "$(layers)"
        }
      ]
    },
    "commands": [
      {
        "command": "manage-skills.openDocs",
        "title": "View Skills Details",
        "icon": "$(book)"
      },
      {
        "command": "manage-skills.redetectTechnologies",
        "title": "Refresh Skills"
      },
      {
        "command": "manage-skills.installSkill",
        "title": "Install Skill",
        "icon": "$(cloud-download)"
      },
      {
        "command": "manage-skills.installTechSkills",
        "title": "Install Technology Skills",
        "icon": "$(arrow-circle-down)"
      },
      {
        "command": "manage-skills.installAllSuggestedSkills",
        "title": "Install All Suggested Skills",
        "icon": "$(layers)"
      },
      {
        "command": "manage-skills.redetectTechnologies",
        "title": "Refresh Skills",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "manage-skills.installTechSkills",
          "when": "viewItem == available-technology || viewItem == installed-technology",
          "group": "inline@1"
        },
        {
          "command": "manage-skills.installAllSuggestedSkills",
          "when": "viewItem == suggested-skills-header",
          "group": "inline@1"
        },
        {
          "command": "manage-skills.redetectTechnologies",
          "when": "viewItem == suggested-skills-header",
          "group": "inline@1"
        },
        {
          "command": "manage-skills.installSkill",
          "when": "viewItem == skill-item",
          "group": "inline@1"
        },
        {
          "command": "manage-skills.openDocs",
          "when": "viewItem == skill-item",
          "group": "inline@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.115.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
