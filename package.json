{
  "name": "manage-skills",
  "displayName": "manage-skills",
  "description": "Para administrar skills intaladas en proyectos del usuario.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.115.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "manageSkillsView",
          "title": "Manage Skills",
          "icon": "resources/skills-icon.svg"
        }
      ]
    },
    "views": {
      "manageSkillsView": [
        {
          "id": "suggestedSkillsView",
          "name": "Suggested Skills",
          "icon": "resources/suggested-skills-icon.svg"
        },
        {
          "id": "skillsView",
          "name": "Skills",
          "icon": "resources/skills-icon.svg"
        },
        {
          "id": "installedSkillsView",
          "name": "Installed Skills",
          "icon": "resources/installed-skills-icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "manage-skills.helloWorld",
        "title": "Hello World"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.115.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
